# ==============================================================================
# FamPay Automated UPI Payment Gateway — Environment Configuration
# Copy this file to `.env.local` for local Next.js / Node.js development
# or add these variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# 1. Merchant & NPCI UPI Configuration (Exposed safely to Checkout UI)
NEXT_PUBLIC_MERCHANT_NAME="Acme Digital Store"
NEXT_PUBLIC_UPI_ID="merchant@fam"

# 2. FamApp / Gmail IMAP Verification Credentials
# Enable 2-Step Verification on your Google Account, then create a 16-character
# App Password at https://myaccount.google.com/apppasswords
GMAIL_USER="your-fampay-linked-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# 3. Firebase Admin SDK (Firestore Database)
# Generate from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# 4. Gateway Security & Webhook Signing Secret
# Used to authenticate server-to-server order creation and sign outgoing webhooks (HMAC-SHA256)
GATEWAY_SECRET_KEY="replace_with_a_strong_32_byte_hex_secret"

# Runtime / Platform Variables
APP_URL="http://localhost:3000"
GEMINI_API_KEY=""
